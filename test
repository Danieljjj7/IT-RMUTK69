  static void SayHi()
  {
      Console.WriteLine("Hello world");
      Console.WriteLine("you 're welcome");
  }
  //สร้างเมธอดแบบไม่คืนค่าและมีพารามิเตอร์ จำนวน 1 ตัว
  static void SayHello(string name)
  {
      Console.WriteLine($"Hello {name}");
      Console.WriteLine("Hello " + name);
      Console.WriteLine("Hello {0}" ,name);
  }
  //สร้างเมธอดแบบไม่คืนค่าและมีพารามิเตอร์ จำนวน 2 ตัว
  static void Say(string name, int y)
  {
      Console.WriteLine("Hi " + name + "your age = " + y);
  }
  //สร้างเมธอดแบบไม่คืนค่าและมีพารามิเตอร์ จำนวน 1 ตัว สำหรับคำนวณเกรด
  static void ComputeGrade(int score)
  {
      if (score >= 80)
          Console.WriteLine("score = " + score + " grade = A");
      else if (score >= 70)
          Console.WriteLine("score = " + score + " grade = B");
      else if (score >= 60)
          Console.WriteLine("score = " + score + " grade = C");
      else if (score >= 50)
          Console.WriteLine("score = " + score + " grade = D");
      else
          Console.WriteLine("score = " + score + " grade = F");

  }
  //สร้างเมธอดแบบไม่คืนค่าและมีพารามิเตอร์ จำนวน 4 ตัว สำหรับคำนวณเกรด
  static void Grade(int attention, int work, int midterm, int final)
  {
      int score = attention + work + midterm + final;
      if (score >= 80)
          Console.WriteLine("score = " + score + " grade = A");
      else if (score >= 70)
          Console.WriteLine("score = " + score + " grade = B");
      else if (score >= 60)
          Console.WriteLine("score = " + score + " grade = C");
      else if (score >= 50)
          Console.WriteLine("score = " + score + " grade = D");
      else
          Console.WriteLine("score = " + score + " grade = F");

  }
  static void PrintStar(int n)
  {
      for (int i = 1; i <= n; i++)
      {
          Console.Write("*");
      }
  }
  //สร้างเมธอดแบบคืนค่าและมีพารามิเตอร์ จำนวน 1 ตัว สำหรับคำนวณเกรด
  static string printGrade(int score)
  {
      string grade = "";
      if (score >= 80)
          grade = "score = " + score + " grade = A";
      else if (score >= 70)
          grade = "score = " + score + " grade = B";
      else if (score >= 60)
          grade = "score = " + score + " grade = C";
      else if (score >= 50)
          grade = "score = " + score + " grade = D";
      else
          grade = "score = " + score + " grade = F";
      return grade;
  }
  //เมธอดแสดงสูตรคูณ แบบคืนค่า ที่มีพารามิเตอร์ จำนวน 2 ตัว
  static string Multiply(int first,int last)
  {
      string result = "";
      for(int i = first;i<= last ;i++)
      {
          result += "\tMultiply " + i + "\n\t" + PrintStar2(20);
          
          for (int j = 1;j <= 12 ;j++ )
          {
              result += "\n\t" + i + " x " + j + " = " + i * j;
          }
          result += "\n";
      }
      return result;
  }
  static string PrintStar2(int n)
  {
      string star = "";
      for (int i = 1; i <= n; i++)
      {
          star += "*";
      }
      return star;
  }
